# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# ID чата/канала/группы, куда бот будет присылать заявки
TELEGRAM_CHAT_ID=123456789

# Секрет для проверки запросов от Telegram на /api/telegram-webhook
# (сгенерировать один раз, например: openssl rand -hex 24)
TELEGRAM_WEBHOOK_SECRET=change-me

# Домен, на котором работает сайт (используется nginx-proxy и для выпуска SSL)
VIRTUAL_HOST=vancodex.tech
LETSENCRYPT_HOST=vancodex.tech
LETSENCRYPT_EMAIL=you@example.com
